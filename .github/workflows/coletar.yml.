name: Coletar oportunidades
on:
  schedule:
    - cron: "0 9 * * *"
  workflow_dispatch: {}
permissions:
  contents: write
  pull-requests: write
jobs:
  coletar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install playwright anthropic
      - run: playwright install --with-deps chromium
      - run: python coletor.py
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
      - uses: peter-evans/create-pull-request@v6
        with:
          branch: coleta-diaria
          title: "Novas oportunidades para revisar"
          body: "Confira prazos e links de cada item antes de aprovar."
          commit-message: "Coleta diária de oportunidades"
          add-paths: docs/oportunidades.json
